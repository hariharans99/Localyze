rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper: User acts on their own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Deleted Users (Blacklist)
    // - Allow creating a record if it matches your email (banning yourself)
    // - Allow reading to check if you are banned
    match /deleted_users/{email} {
      allow read: if true; 
      allow create: if request.auth != null && request.auth.token.email == email;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // CREATE: Strict initialization
      allow create: if isOwner(userId)
                    && request.resource.data.plan == 'free'
                    && request.resource.data.usage.count == 0;

      // UPDATE: Allow user to update their own data (including Plan upgrades)
      // Previously restricted, but now relaxed to support 'upgradePlan' & usage tracking
      allow update: if isOwner(userId);

      // DELETE: Allow user to delete their own account
      allow delete: if isOwner(userId);

      // Operations: Append-only log
      match /operations/{opId} {
        allow read, create: if isOwner(userId);
        allow delete: if isOwner(userId); // Allow cleanup if needed
      }
      
      // History: Append-only
      match /history/{histId} {
        allow read, create: if isOwner(userId);
        allow delete: if isOwner(userId); // Allow cleanup if needed
      }
    }
  }
}
