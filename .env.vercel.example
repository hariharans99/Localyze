# Vercel Environment Variables (DO NOT COMMIT)
# Copy this to .env.local for local testing
# Add these to Vercel dashboard for production

# Razorpay
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Firebase
VITE_FIREBASE_PROJECT_ID=localyze-b58dc
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"localyze-b58dc",...}

# Note: Get FIREBASE_SERVICE_ACCOUNT from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Then copy the entire JSON content as a single-line string
